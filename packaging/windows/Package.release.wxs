<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?define LucentVersion="0.1.0-rc4"?>
  <Package
      Name="Voxprint AI Lucent"
      Manufacturer="Aleksandr Mitroshenkov"
      Version="0.1.0.4"
      UpgradeCode="7C2A9E14-6B0F-4E3A-9D55-1A2B3C4D5E6F"
      Scope="perUser"
      Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Voxprint AI Lucent is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="Main" Title="Voxprint AI Lucent" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="VoxprintFolder" Name="Voxprint">
        <Directory Id="INSTALLFOLDER" Name="Lucent" />
      </Directory>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.Payload)/**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="6f0c2a1e-4b7d-4e8a-9c31-2d5e7f8a9b01">
        <Shortcut
            Id="ApplicationStartMenuShortcut"
            Name="Voxprint AI Lucent"
            Description="Image viewer"
            Target="[INSTALLFOLDER]voxprint-lucent.exe"
            WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Voxprint\Lucent"
            Name="InstallPath"
            Type="string"
            Value="[INSTALLFOLDER]"
            KeyPath="yes" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Voxprint\Lucent"
            Name="Exe"
            Type="string"
            Value="[INSTALLFOLDER]voxprint-lucent.exe" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Voxprint\Lucent"
            Name="Version"
            Type="string"
            Value="$(var.LucentVersion)" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Voxprint\Lucent"
            Name="IpcName"
            Type="string"
            Value="voxprint-lucent" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Voxprint\Lucent"
            Name="ProtocolVersion"
            Type="integer"
            Value="1" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Microsoft\Windows\CurrentVersion\App Paths\voxprint-lucent.exe"
            Type="string"
            Value="[INSTALLFOLDER]voxprint-lucent.exe" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Microsoft\Windows\CurrentVersion\App Paths\voxprint-lucent.exe"
            Name="Path"
            Type="string"
            Value="[INSTALLFOLDER]" />
      </Component>
    </StandardDirectory>
  </Fragment>
</Wix>
