<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?define LucentVersion="0.1.0-rc7"?>
  <?define LucentBuild="8"?>
  <Package
      Name="VOXPrint AI Lucent"
      Manufacturer="VOXPrint AI Suite"
      Version="0.1.0.7"
      UpgradeCode="7C2A9E14-6B0F-4E3A-9D55-1A2B3C4D5E6F"
      Scope="perMachine"
      Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of VOXPrint AI Lucent is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="Main" Title="VOXPrint AI Lucent" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="SuiteFolder" Name="VOXPrint AI Suite">
        <Directory Id="INSTALLFOLDER" Name="Lucent" />
      </Directory>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.Payload)/**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="SuiteMenuFolder" Name="VOXPrint AI Suite">
        <Component Id="StartMenuShortcut" Guid="8b1e4c2a-5d70-4f91-a042-3e6f8091c212">
          <Shortcut
              Id="ApplicationStartMenuShortcut"
              Name="VOXPrint AI Lucent"
              Description="Image viewer"
              Target="[INSTALLFOLDER]voxprint-lucent.exe"
              WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveSuiteMenu" Directory="SuiteMenuFolder" On="uninstall" />
          <RegistryValue
              Root="HKLM"
              Key="Software\VOXPrint\Lucent"
              Name="InstallPath"
              Type="string"
              Value="[INSTALLFOLDER]"
              KeyPath="yes" />
          <RegistryValue
              Root="HKLM"
              Key="Software\VOXPrint\Lucent"
              Name="Exe"
              Type="string"
              Value="voxprint-lucent.exe" />
          <RegistryValue
              Root="HKLM"
              Key="Software\VOXPrint\Lucent"
              Name="CliExe"
              Type="string"
              Value="voxprint-lucent-cli.exe" />
          <RegistryValue
              Root="HKLM"
              Key="Software\VOXPrint\Lucent"
              Name="Version"
              Type="string"
              Value="$(var.LucentVersion)" />
          <RegistryValue
              Root="HKLM"
              Key="Software\VOXPrint\Lucent"
              Name="Build"
              Type="integer"
              Value="$(var.LucentBuild)" />
          <RegistryValue
              Root="HKLM"
              Key="Software\VOXPrint\Lucent"
              Name="IpcName"
              Type="string"
              Value="voxprint-lucent" />
          <RegistryValue
              Root="HKLM"
              Key="Software\VOXPrint\Lucent"
              Name="ProtocolVersion"
              Type="integer"
              Value="1" />
          <RegistryValue
              Root="HKLM"
              Key="Software\Microsoft\Windows\CurrentVersion\App Paths\voxprint-lucent.exe"
              Type="string"
              Value="[INSTALLFOLDER]voxprint-lucent.exe" />
          <RegistryValue
              Root="HKLM"
              Key="Software\Microsoft\Windows\CurrentVersion\App Paths\voxprint-lucent.exe"
              Name="Path"
              Type="string"
              Value="[INSTALLFOLDER]" />
          <RegistryValue
              Root="HKLM"
              Key="Software\Microsoft\Windows\CurrentVersion\App Paths\voxprint-lucent-cli.exe"
              Type="string"
              Value="[INSTALLFOLDER]voxprint-lucent-cli.exe" />
          <RegistryValue
              Root="HKLM"
              Key="Software\Microsoft\Windows\CurrentVersion\App Paths\voxprint-lucent-cli.exe"
              Name="Path"
              Type="string"
              Value="[INSTALLFOLDER]" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Fragment>
</Wix>
